{
  "name": "@elpapi42/pi-fleet-sdk",
  "version": "0.13.0",
  "description": "SDK for durable, host-local Pi agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elpapi42/pi-fleet.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.json",
    "test": "node --test --test-concurrency=1 test/public/*.test.mjs test/fleet/*.test.mjs test/state/*.test.mjs test/pi/*.test.mjs test/worker/*.test.mjs"
  },
  "dependencies": {
    "lmdb": "3.5.6",
    "zeromq": "6.6.0"
  }
}
